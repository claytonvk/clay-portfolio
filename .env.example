# ─────────────────────────────────────────────────────────────
# Clay Portfolio — Admin Dashboard environment variables
# Copy this file to `.env.local` and fill in the values.
# Everything here uses a FREE tier. See ADMIN_SETUP.md for how to get each one.
# The dashboard works incrementally: any integration left blank simply shows
# a "not connected" state until you add its key.
# ─────────────────────────────────────────────────────────────

# --- Supabase (database + auth) --- REQUIRED for the dashboard to function
# Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by the weekly cron to write audit rows. Keep secret.
SUPABASE_SERVICE_ROLE_KEY=

# --- Vercel (deployments, domains, runtime errors) ---
# Vercel → Account Settings → Tokens
VERCEL_API_TOKEN=
# Your team id (already known — leave as-is unless it changes)
VERCEL_TEAM_ID=team_clvhMnS1es1vze9XYyfbjRYa

# --- Google PageSpeed Insights (Lighthouse: performance / SEO / a11y) ---
# Google Cloud Console → enable "PageSpeed Insights API" → create API key
PAGESPEED_API_KEY=

# --- GitHub (read package.json, commits, repo activity) ---
# GitHub → Settings → Developer settings → Fine-grained token
# Permissions: Contents = Read-only, Metadata = Read-only on the client repos
GITHUB_TOKEN=

# --- Google Gemini (writes the AI audit summaries — free tier) ---
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Optional model override. Free-tier quotas are per-model, so if one is
# exhausted you can switch (e.g. gemini-2.5-flash-lite). Defaults to gemini-2.5-flash.
GEMINI_MODEL=

# --- Resend (weekly audit email — free tier) ---
# https://resend.com/api-keys
RESEND_API_KEY=
# Who receives the weekly digest
AUDIT_EMAIL_TO=clay@kdk.dev
# Sender. Use onboarding@resend.dev until you verify your own domain in Resend.
AUDIT_EMAIL_FROM=onboarding@resend.dev

# --- Cron protection (generate a long random string) ---
CRON_SECRET=

# --- Misc ---
# Used to build links inside the audit email
NEXT_PUBLIC_SITE_URL=https://clayvanderkolk.site

# Vercel project names to hide from the dashboard (comma-separated).
# Defaults to the portfolio itself so it doesn't monitor the site you're viewing from.
EXCLUDED_PROJECTS=clay-portfolio
